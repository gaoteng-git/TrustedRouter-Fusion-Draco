### Compliance and Audit Trail¶

Track secret lifecycle with rotation policies:

```
version: '1.0'

metadata:
  project: secure-app
  compliance:
    - soc2
    - iso27001

policies:
  critical_rotation:
    kind: rotation
    require_rotation_period: true
    max_age: 90d
    severity: error
    enabled: true

secrets:
  - name: production_api_key
    kind: random_string
    rotation_period: 90d  # Enforce 90-day rotation
    config:
      length: 32
    targets:
      - provider: github
        kind: github_secret
        config:
          owner: myorganization
          repo: production-app
          environment: production
          secret_name: API_KEY

```

