        description: "Target environment"
        required: true
        type: string
    secrets:
      NPM_TOKEN:
        required: false
    outputs:
      artifact-name:
        description: "Name of the uploaded build artifact"
        value: ${{ jobs.build.outputs.artifact-name }}
...
